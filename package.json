{
    "name": "audio-wandas-analyzer",
    "displayName": "Audio Wandas Analyzer",
    "description": "Analyze audio files in VS Code with a TypeScript extension UI and a Python backend powered by wandas.",
    "version": "0.0.14",
    "publisher": "audio-wandas-analyzer",
    "repository": {
        "type": "git",
        "url": "https://github.com/kasahart/audio-wandas-analyzer"
    },
    "engines": {
        "vscode": "^1.96.0",
        "node": ">=22"
    },
    "categories": [
        "Data Science",
        "Visualization"
    ],
    "keywords": [
        "audio",
        "audio-analysis",
        "audio-viewer",
        "audio-comparison",
        "waveform",
        "spectrogram",
        "spectrum",
        "fft",
        "stft",
        "octave-band",
        "transfer-function",
        "coherence",
        "loudness",
        "psychoacoustics",
        "signal-processing",
        "acoustics",
        "noise",
        "wav",
        "flac",
        "recipe",
        "wandas",
        "python",
        "音声",
        "音響"
    ],
    "activationEvents": [
        "workspaceContains:media/debug/chirp-200-3200.wav"
    ],
    "main": "./dist/extension/bootstrap.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "restrictedConfigurations": [
                "audioWandasAnalyzer.pythonCommand",
                "audioWandasAnalyzer.debugFilePath"
            ],
            "description": "%capabilities.untrustedWorkspaces.description%"
        },
        "virtualWorkspaces": false
    },
    "icon": "media/Marketplace-icon.png",
    "contributes": {
        "commands": [
            {
                "command": "audioWandasAnalyzer.analyzeFile",
                "title": "%command.analyzeFile.title%"
            },
            {
                "command": "audioWandasAnalyzer.analyzeThisTarget",
                "title": "%command.analyzeThisTarget.title%"
            },
            {
                "command": "audioWandasAnalyzer.analyzeDebugFile",
                "title": "%command.analyzeDebugFile.title%"
            },
            {
                "command": "audioWandasAnalyzer.selectPythonEnvironment",
                "title": "%command.selectPythonEnvironment.title%"
            },
            {
                "command": "audioWandasAnalyzer.runRecipe",
                "title": "%command.runRecipe.title%"
            },
            {
                "command": "audioWandasAnalyzer.configureCalibration",
                "title": "%command.configureCalibration.title%"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "audioWandasAnalyzer.analyzeDebugFile",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "command": "audioWandasAnalyzer.analyzeThisTarget",
                    "when": "resourceExtname =~ /^\\.(wav|flac|ogg|oga|opus|mp3|aiff|aif|au|snd|caf|rf64|w64|csv)$/i",
                    "group": "2_workspace"
                },
                {
                    "command": "audioWandasAnalyzer.analyzeThisTarget",
                    "when": "explorerResourceIsFolder",
                    "group": "2_workspace"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "audioWandasAnalyzer",
                    "title": "%viewsContainer.title%",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "audioWandasAnalyzer": [
                {
                    "id": "audioWandasAnalyzer.welcomeView",
                    "name": "%views.welcomeView.name%"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "audioWandasAnalyzer.welcomeView",
                "contents": "%viewsWelcome.contents%"
            }
        ],
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "audioWandasAnalyzer.pythonCommand": {
                    "type": "string",
                    "default": "python3",
                    "description": "%configuration.pythonCommand.description%"
                },
                "audioWandasAnalyzer.debugFilePath": {
                    "type": "string",
                    "default": "media/debug",
                    "description": "%configuration.debugFilePath.description%"
                },
                "audioWandasAnalyzer.cacheMemoryMb": {
                    "type": "number",
                    "default": 1024,
                    "minimum": 64,
                    "description": "%configuration.cacheMemoryMb.description%",
                    "scope": "window"
                }
            }
        }
    },
    "scripts": {
        "compile": "node scripts/clean-dist.js && tsc -p ./ && node scripts/build-webview.js",
        "watch": "node scripts/watch-webview.js",
        "package": "npm run compile",
        "vscode:prepublish": "npm run compile",
        "package:vsix": "vsce package --no-yarn",
        "lint:webview-patterns": "node scripts/lint-webview-patterns.js",
        "lint:gui-triggerability": "node scripts/verify-gui-triggerability.js",
        "test": "npm run compile && node --test \"dist/test/**/*.test.js\"",
        "test:ui": "npm run compile && node scripts/playwright.mjs test",
        "test:e2e:vscode": "npm run compile && node scripts/e2e-vscode.mjs",
        "verify": "node scripts/verify.mjs",
        "verify:e2e": "npm run test:e2e:vscode",
        "test:ui:install": "node scripts/playwright.mjs install --with-deps chromium",
        "build:browser": "npm run compile && node scripts/build-browser.js",
        "prepare:browser": "python3 scripts/prepare-browser-runtime.py",
        "test:browser": "npm run build:browser && node scripts/test-browser-parity.js",
        "gui-core:check": "node scripts/sync-gui-core.mjs --check src/shared/gui-core",
        "precompile": "npm run gui-core:check"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.140.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "ajv": "^8.20.0",
        "esbuild": "0.28.2",
        "jsdom": "^30.1.3",
        "typescript": "^7.0.2"
    }
}
